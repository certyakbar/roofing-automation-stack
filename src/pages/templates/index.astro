---
import CategoryLayout from '../../layouts/CategoryLayout.astro';

const base = import.meta.env.BASE_URL;

const templates = [
  {
    href: `${base}/templates/lead-follow-up-checklist/`,
    title: 'Roofing Lead Follow-Up Automation Checklist',
    description: 'Step-by-step checklist to implement automated lead follow-up for your roofing business.',
    tag: 'Free',
  },
];
---

<CategoryLayout
  title="Free Roofing Automation Templates & Checklists"
  description="Free templates, checklists, and frameworks for roofing companies implementing automation. No email required for most resources."
  category="Templates"
  intro="Practical, ready-to-use templates and checklists for roofing companies implementing CRM, lead follow-up, and sales automation."
>
  <ul class="template-list">
    {templates.map(t => (
      <li class="template-item">
        <div class="template-meta">
          {t.tag && <span class="template-tag">{t.tag}</span>}
          <a href={t.href} class="template-title">{t.title}</a>
          <p class="template-description">{t.description}</p>
        </div>
        <a href={t.href} class="template-link">View Template →</a>
      </li>
    ))}
  </ul>
</CategoryLayout>

<style>
  .template-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }

  .template-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    flex-wrap: wrap;
  }

  .template-meta { flex: 1; }

  .template-tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: #dcfce7;
    color: #166534;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    margin-bottom: 0.4rem;
  }

  .template-title {
    display: block;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    font-size: 1rem;
    margin-bottom: 0.3rem;
  }

  .template-title:hover { color: var(--color-accent); }

  .template-description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .template-link {
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
    align-self: center;
  }

  .template-link:hover { text-decoration: underline; }
</style>
