---
interface Props {
  name: string;
  tagline: string;
  description: string;
  bestFor: string;
  pricing: string;
  affiliateHref?: string;
  reviewHref?: string;
  badge?: string;
}

const { name, tagline, description, bestFor, pricing, affiliateHref, reviewHref, badge } = Astro.props;
---

<article class="tool-card">
  {badge && <span class="tool-badge">{badge}</span>}
  <div class="tool-header">
    <h3 class="tool-name">{name}</h3>
    <p class="tool-tagline text-muted">{tagline}</p>
  </div>
  <p class="tool-description">{description}</p>
  <dl class="tool-meta">
    <div class="meta-row">
      <dt>Best for</dt>
      <dd>{bestFor}</dd>
    </div>
    <div class="meta-row">
      <dt>Pricing</dt>
      <dd>{pricing}</dd>
    </div>
  </dl>
  <div class="tool-actions">
    {affiliateHref && (
      <a href={affiliateHref} class="btn-primary" rel="nofollow sponsored" target="_blank">
        Visit {name} →
      </a>
    )}
    {reviewHref && (
      <a href={reviewHref} class="btn-secondary">
        Read our overview
      </a>
    )}
  </div>
</article>

<style>
  .tool-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    background: #fff;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: box-shadow 0.15s;
  }

  .tool-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); }

  .tool-badge {
    position: absolute;
    top: -0.6rem;
    left: 1rem;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .tool-name {
    font-size: 1.2rem;
    margin: 0;
  }

  .tool-tagline {
    font-size: 0.875rem;
    margin: 0.25rem 0 0;
  }

  .tool-description {
    font-size: 0.9rem;
    margin: 0;
    line-height: 1.55;
  }

  .tool-meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: var(--color-bg-alt);
    border-radius: 6px;
    padding: 0.75rem;
    font-size: 0.85rem;
  }

  .meta-row {
    display: flex;
    gap: 0.5rem;
  }

  .meta-row dt {
    font-weight: 600;
    color: var(--color-text-muted);
    min-width: 70px;
    flex-shrink: 0;
  }

  .meta-row dd { margin: 0; }

  .tool-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: auto;
  }

  .btn-primary, .btn-secondary {
    display: inline-block;
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  .btn-primary {
    background: var(--color-accent);
    color: #fff;
  }

  .btn-primary:hover { background: var(--color-accent-hover); color: #fff; }

  .btn-secondary {
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover { background: var(--color-bg-alt); }
</style>
