---
interface Guide {
  title: string;
  href: string;
  description: string;
}

interface Props {
  guides: Guide[];
  heading?: string;
}

const { guides, heading = 'Related Guides' } = Astro.props;
---

<nav class="related-guides" aria-labelledby="related-heading">
  <h2 id="related-heading">{heading}</h2>
  <ul class="related-list">
    {guides.map(guide => (
      <li class="related-item">
        <a href={guide.href} class="related-link">
          <span class="related-title">{guide.title}</span>
          <span class="related-description">{guide.description}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .related-guides {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .related-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin-top: 1rem;
  }

  .related-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    background: var(--color-bg-alt);
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .related-link:hover {
    border-color: var(--color-accent);
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .related-title {
    font-weight: 600;
    color: var(--color-primary);
    font-size: 0.9rem;
  }

  .related-description {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }
</style>
