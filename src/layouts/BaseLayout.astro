---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
}

const { title, description, canonicalURL, ogImage } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;

const navLinks = [
  { href: `${base}/crm/`, label: 'CRM' },
  { href: `${base}/lead-follow-up/`, label: 'Lead Follow-Up' },
  { href: `${base}/missed-calls/`, label: 'Missed Calls' },
  { href: `${base}/ai-receptionists/`, label: 'AI Receptionists' },
  { href: `${base}/call-tracking/`, label: 'Call Tracking' },
  { href: `${base}/outbound/`, label: 'Outbound' },
  { href: `${base}/comparisons/`, label: 'Comparisons' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="aJ9VtrUlOSFyCyf1AkTtD2kEcrcaXvc12hatdrjGUu8" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href={`${base}/`} class="site-logo" aria-label="Roofing Automation Stack home">
          <span class="logo-icon">🏗️</span>
          <span class="logo-text">Roofing Automation Stack</span>
        </a>
        <nav aria-label="Main navigation">
          <ul class="nav-list">
            {navLinks.map(link => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-links">
          <a href={`${base}/`}>Home</a>
          <a href={`${base}/templates/`}>Templates</a>
          <a href={`${base}/calculators/`}>Calculators</a>
          <a href={`${base}/comparisons/`}>Comparisons</a>
        </div>
        <p class="footer-disclosure">
          <strong>Affiliate Disclosure:</strong> This site contains affiliate links. We may earn a commission when you purchase through our links at no extra cost to you. We only recommend tools we believe can genuinely help roofing businesses.
        </p>
        <p class="footer-copy">&copy; {new Date().getFullYear()} Roofing Automation Stack. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    background: var(--color-primary);
    color: #fff;
    padding: 0.75rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
    white-space: nowrap;
  }

  .site-logo:hover { color: var(--color-accent); }

  .logo-icon { font-size: 1.4rem; }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-list a {
    color: #cbd5e0;
    text-decoration: none;
    font-size: 0.875rem;
    padding: 0.25rem 0;
    transition: color 0.15s;
  }

  .nav-list a:hover { color: var(--color-accent); }

  .site-footer {
    background: #111827;
    color: #9ca3af;
    padding: 2.5rem 0;
    margin-top: 4rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-links a {
    color: #d1d5db;
    text-decoration: none;
    font-size: 0.875rem;
  }

  .footer-links a:hover { color: var(--color-accent); }

  .footer-disclosure {
    font-size: 0.8rem;
    line-height: 1.5;
    max-width: 70ch;
    margin: 0;
  }

  .footer-copy {
    font-size: 0.8rem;
    margin: 0;
    color: #6b7280;
  }
</style>
