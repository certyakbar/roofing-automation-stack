---
import BaseLayout from './BaseLayout.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import CTABox from '../components/CTABox.astro';
import FAQSection from '../components/FAQSection.astro';
import RelatedGuides from '../components/RelatedGuides.astro';

interface FAQItem {
  question: string;
  answer: string;
}

interface RelatedGuide {
  title: string;
  href: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  publishDate?: string;
  updatedDate?: string;
  faqs?: FAQItem[];
  relatedGuides?: RelatedGuide[];
  showDisclosure?: boolean;
  showCTA?: boolean;
}

const {
  title,
  description,
  canonicalURL,
  publishDate,
  updatedDate,
  faqs = [],
  relatedGuides = [],
  showDisclosure = true,
  showCTA = true,
} = Astro.props;
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL}>
  <article class="article-wrap">
    <div class="container article-container">
      <header class="article-header">
        <h1>{title}</h1>
        {(publishDate || updatedDate) && (
          <p class="article-meta text-muted">
            {publishDate && <time datetime={publishDate}>Published {new Date(publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>}
            {updatedDate && <span> · Updated {new Date(updatedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>}
          </p>
        )}
      </header>

      {showDisclosure && <AffiliateDisclosure />}

      <div class="article-body">
        <slot />
      </div>

      {showCTA && <CTABox />}

      {faqs.length > 0 && <FAQSection items={faqs} />}

      {relatedGuides.length > 0 && <RelatedGuides guides={relatedGuides} />}
    </div>
  </article>
</BaseLayout>

<style>
  .article-wrap {
    padding: 2.5rem 0;
  }

  .article-container {
    max-width: 820px;
  }

  .article-header {
    margin-bottom: 1.5rem;
  }

  .article-meta {
    margin-top: 0.5rem;
    font-size: 0.875rem;
  }

  .article-body {
    margin-top: 2rem;
  }

  .article-body :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .article-body :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }

  .article-body :global(th),
  .article-body :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.6rem 0.9rem;
    text-align: left;
  }

  .article-body :global(th) {
    background: var(--color-bg-alt);
    font-weight: 600;
  }

  .article-body :global(tr:nth-child(even)) {
    background: #fafafa;
  }
</style>
