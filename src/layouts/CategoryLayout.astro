---
import BaseLayout from './BaseLayout.astro';
import CTABox from '../components/CTABox.astro';

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  intro: string;
  category: string;
}

const { title, description, canonicalURL, intro, category } = Astro.props;
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL}>
  <section class="category-hero">
    <div class="container">
      <div class="breadcrumb text-muted">
        <a href={import.meta.env.BASE_URL + '/'}>Home</a>
        <span aria-hidden="true"> / </span>
        <span>{category}</span>
      </div>
      <h1>{title}</h1>
      <p class="category-intro">{intro}</p>
    </div>
  </section>

  <div class="container category-body">
    <slot />
    <CTABox />
  </div>
</BaseLayout>

<style>
  .category-hero {
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
    padding: 3rem 0 2rem;
  }

  .breadcrumb {
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover { color: var(--color-accent); }

  .category-intro {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 70ch;
    margin-top: 0.75rem;
    margin-bottom: 0;
  }

  .category-body {
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }
</style>
